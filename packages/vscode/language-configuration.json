{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"], ["{", "}"]],
  "autoClosingPairs": [{ "open": "[", "close": "]" }, { "open": "{", "close": "}" }],
  "surroundingPairs": [["[", "]"], ["{", "}"]],
  "indentationRules": { "increaseIndentPattern": "^\\s*(loop|branch|else)\\b.*$", "decreaseIndentPattern": "^\\s*(end|else)\\b.*$" },
  "folding": { "markers": { "start": "^\\s*(loop|branch)\\b", "end": "^\\s*end\\b" } }
}
