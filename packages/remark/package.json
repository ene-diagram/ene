{
  "name": "@ene-diagram/remark",
  "version": "0.1.1",
  "description": "remark and markdown-it plugins that render ```ene code blocks as animated diagrams",
  "keywords": [
    "ene",
    "diagram",
    "animated-diagram",
    "remark",
    "rehype",
    "markdown-it",
    "mdx"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ene-diagram/ene.git",
    "directory": "packages/remark"
  },
  "homepage": "https://github.com/ene-diagram/ene/tree/main/packages/remark#readme",
  "bugs": "https://github.com/ene-diagram/ene/issues",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown-it": {
      "types": "./dist/markdown-it.d.ts",
      "default": "./dist/markdown-it.js"
    }
  },
  "dependencies": {
    "@ene-diagram/core": "workspace:*",
    "@ene-diagram/layout": "workspace:*",
    "@ene-diagram/svg": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/markdown-it": "^14.2.0",
    "markdown-it": "^14.3.3",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
