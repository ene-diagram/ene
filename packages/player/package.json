{
  "name": "@ene-diagram/player",
  "version": "0.1.1",
  "description": "Browser player for ene diagrams",
  "keywords": [
    "ene",
    "diagram",
    "animated-diagram",
    "text-to-diagram",
    "player",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ene-diagram/ene.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/ene-diagram/ene#readme",
  "bugs": "https://github.com/ene-diagram/ene/issues",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/ene.js",
  "unpkg": "./dist/ene.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "bundle": "esbuild src/browser.ts --bundle --format=iife --global-name=ene --outfile=dist/ene.js --minify --external:elkjs/lib/elk.bundled.js && cp \"$(node -p \"require.resolve('elkjs/lib/elk.bundled.js',{paths:['../layout']})\")\" dist/ene-elk.js"
  },
  "dependencies": {
    "@ene-diagram/core": "workspace:*",
    "@ene-diagram/layout": "workspace:*",
    "@ene-diagram/svg": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
