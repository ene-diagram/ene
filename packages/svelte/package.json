{
  "name": "@ene-diagram/svelte",
  "version": "0.1.1",
  "description": "Svelte 5 component for ene animated diagrams",
  "keywords": [
    "ene",
    "diagram",
    "animated-diagram",
    "text-to-diagram",
    "svelte",
    "sveltekit",
    "component"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ene-diagram/ene.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/ene-diagram/ene/tree/main/packages/svelte#readme",
  "bugs": "https://github.com/ene-diagram/ene/issues",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ene-diagram/player": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "svelte": "./dist/index.js",
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.57.3",
    "@sveltejs/package": "^3.0.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1"
  }
}
