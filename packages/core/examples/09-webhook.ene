# A payment provider sends a webhook. The receiver enqueues it and replies 200 at once. The handler's
# first delivery to a partner API fails with 500, is rescheduled through the queue and succeeds on
# retry.
title Webhook delivery and retry
stripe[Payment Provider] -> hook[Webhook Receiver] : payment.succeeded
hook -> queue[Queue] : enqueue
hook --> stripe : 200
queue -> handler[Handler] : event
handler -x partner[Partner API] : 500
wait 0.5
handler -> queue : schedule retry
queue -> handler : event (retry)
handler -> partner : deliver
partner --> handler : 200
