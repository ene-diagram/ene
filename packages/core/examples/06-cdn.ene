# A browser requests a static file from a CDN edge. Branch: on an edge hit the cached copy is
# returned; on a miss the edge fetches it from the origin first. Each request is logged.
title CDN cache
browser[Browser] -> edge[CDN Edge] : GET /app.js
branch edge hit
  edge --> browser : 200 (cached)
else edge miss
  edge -> origin[Origin] : GET /app.js
  origin --> edge : 200 + Cache-Control
  edge --> browser : 200
end
edge -> logs[Log Collector] : access log
